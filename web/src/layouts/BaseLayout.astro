---
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/astro.css';
import '../styles/app.css';

interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#18181b" />
    <meta name="description" content="Panel de control del servidor Arma 3 de Brigada 46" />
    <title>{title}</title>
    <link rel="preload" href="/assets/brigada_46.png" as="image" />
    <script is:inline src="/config.js"></script>
  </head>
  <body>
    <slot />
    <div id="version-badge" class="version-badge" style="display:none"></div>
    <script>
      import '../scripts/runtime.js';
    </script>
    <script is:inline>
      (function () {
        var API_BASE = (window.ARMA3_API_BASE || '').replace(/\/$/, '');
        fetch(API_BASE + '/api/health', { credentials: API_BASE ? 'include' : 'same-origin' })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            var el = document.getElementById('version-badge');
            if (!el || !data || !data.commit) return;
            var commit = data.commit === 'unknown' ? 'unknown' : data.commit.slice(0, 10);
            el.textContent = commit;
            el.title = 'commit ' + data.commit + (data.buildDate ? '\nbuilt ' + data.buildDate : '');
            el.style.display = '';
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
